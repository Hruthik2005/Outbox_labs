datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(cuid())
  googleId         String?           @unique
  name             String
  email            String            @unique
  passwordHash     String?           @db.Text
  avatarUrl        String?           @db.Text
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  senders          Sender[]
  campaigns        Campaign[]
  emails           Email[]
  slackConnections SlackConnection[]

  @@map("users")
}

model Sender {
  id                  String     @id @default(cuid())
  userId              String
  name                String
  email               String
  host                String
  port                Int        @default(587)
  encryptedUsername   String     @db.Text
  encryptedPassword   String     @db.Text
  secure              Boolean    @default(false)
  hourlyLimit         Int        @default(100)
  minimumDelaySeconds Int        @default(2)
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns           Campaign[]
  emails              Email[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("senders")
}

model Campaign {
  id                  String   @id @default(cuid())
  userId              String
  senderId            String
  subject             String
  body                String   @db.Text
  startAt             DateTime
  minimumDelaySeconds Int      @default(2)
  hourlyLimit         Int      @default(100)
  totalRecipients     Int      @default(0)
  status              String   @default("SCHEDULED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender              Sender   @relation(fields: [senderId], references: [id], onDelete: Restrict)
  emails              Email[]

  @@index([userId])
  @@index([senderId])
  @@index([status])
  @@map("campaigns")
}

model Email {
  id                 String       @id @default(cuid())
  userId             String
  campaignId         String
  senderId           String
  recipient          String
  subject            String
  body               String?      @db.Text
  scheduledAt        DateTime
  sentAt             DateTime?
  status             String       @default("SCHEDULED")
  idempotencyKey     String       @unique
  bullJobId          String?
  attemptCount       Int          @default(0)
  lastError          String?      @db.Text
  providerMessageId  String?
  etherealPreviewUrl String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign           Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender             Sender       @relation(fields: [senderId], references: [id], onDelete: Restrict)
  events             EmailEvent[]

  @@index([userId, status])
  @@index([scheduledAt])
  @@index([campaignId])
  @@index([senderId])
  @@index([bullJobId])
  @@map("emails")
}

model SlackConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique
  teamId               String
  teamName             String
  channelId            String?
  channelName          String?
  encryptedAccessToken String   @db.Text
  scopes               String   @db.Text
  connectedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("slack_connections")
}

model EmailEvent {
  id        String   @id @default(cuid())
  emailId   String
  eventType String
  details   String?  @db.Text
  createdAt DateTime @default(now())
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, createdAt])
  @@map("email_events")
}

model OutboxEvent {
  id          String    @id @default(cuid())
  eventType   String
  aggregateId String
  payload     String    @db.Text
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
  @@index([eventType])
  @@index([createdAt])
  @@map("outbox_events")
}
