# ==============================================================================
# ReachInbox Email Scheduler - Environment Configuration Reference
# ==============================================================================

NODE_ENV=development
API_PORT=8383
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:8383

# ------------------------------------------------------------------------------
# Relational Database: MySQL
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://reachinbox:reachinbox_secret@localhost:3306/reachinbox"

# ------------------------------------------------------------------------------
# In-Memory Store & BullMQ Broker: Redis
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Search Engine: Elasticsearch
# ------------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=reachinbox_es_pass

# ------------------------------------------------------------------------------
# Authentication: Real Google OAuth 2.0
# (Create credentials in Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:8383/api/auth/google/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8383/api/auth/google/callback

# ------------------------------------------------------------------------------
# Slack Integration: Real Slack OAuth 2.0 & Notifications
# (Create app at api.slack.com/apps -> OAuth & Permissions)
# Scopes: chat:write, incoming-webhook
# Authorized redirect URI: http://localhost:8383/api/slack/callback
# ------------------------------------------------------------------------------
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_CALLBACK_URL=http://localhost:8383/api/slack/callback

# ------------------------------------------------------------------------------
# Security & Encryption (AES-256-GCM 32-byte hexadecimal key)
# ------------------------------------------------------------------------------
SESSION_SECRET=reachinbox_secure_super_secret_session_key_32chars!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Email Delivery: Ethereal SMTP Testing Credentials
# (Can be auto-generated or obtained at https://ethereal.email/create)
# ------------------------------------------------------------------------------
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

# ------------------------------------------------------------------------------
# BullMQ Worker Concurrency, Send Pacing & Distributed Rate Limiting
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100
RATE_LIMIT_WINDOW_SECONDS=3600
OUTBOX_POLL_INTERVAL_MS=2000

# ------------------------------------------------------------------------------
# Admin & Observability
# ------------------------------------------------------------------------------
ADMIN_SECRET_KEY=admin_queue_dashboard_secret_access_token_8383
LOG_LEVEL=info
