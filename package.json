{
  "name": "reachinbox-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Full-Stack Email Job Scheduler with BullMQ, Redis, MySQL, and Elasticsearch",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@reachinbox/api",
    "dev:worker": "npm run dev --workspace=@reachinbox/worker",
    "dev:web": "npm run dev --workspace=@reachinbox/web",
    "dev": "npm run dev:api",
    "test": "vitest run tests/integration",
    "test:load": "tsx tests/load/load-test-1000.ts",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.5.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
